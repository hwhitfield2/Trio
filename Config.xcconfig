// Identity of the Trio host this follower pairs with.
//
// The follower does not have an Xcode project of its own -- its iOS shell is
// generated by tool/prepare_platforms.sh -- so this file exists only to give
// fastlane the same BUNDLE_IDENTIFIER the Trio repository's Config.xcconfig
// gives it. Everything the follower needs is derived from it:
//
//   follower app     org.nightscout.<TEAMID>.triofollower
//   follower widget  org.nightscout.<TEAMID>.triofollower.widget
//   app group        group.org.nightscout.<TEAMID>.trio.trio-app-group
//
// Change it only if the Trio build you pair against changed its own, and then
// change it to exactly the same string: the app group is shared with that
// build's, and the bundle ids are what App Store Connect and fastlane match
// already have records for.
BUNDLE_IDENTIFIER = org.nightscout.$(DEVELOPMENT_TEAM).trio

// Do not modify: this exact format is required to build with GitHub Actions.
TRIO_APP_GROUP_ID = group.org.nightscout.$(DEVELOPMENT_TEAM).trio.trio-app-group

// Optional override, to insert your TEAMID into the DEVELOPMENT_TEAM field.
#include? "ConfigOverride.xcconfig"
