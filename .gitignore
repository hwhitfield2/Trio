# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
pubspec.lock

# Platform shells. This repository holds only the Dart code and the platform
# sources under platform/; tool/prepare_platforms.sh generates ios/ and
# android/ from them with `flutter create` and patches them, on every CI run
# and before every local build. Committing the generated output would mean
# maintaining it by hand against whatever template the installed Flutter SDK
# ships.
/ios/
/android/
# Written by `flutter create` too, and it pins the exact Flutter revision that
# generated the shells - which differs per builder and per CI run.
/.metadata

# Firebase config for FCM status pushes on Android: written by
# prepare_platforms.sh from the FOLLOWER_GOOGLE_SERVICES_JSON secret, or
# dropped in by hand for a local build. Never commit it.
google-services.json

